{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2020"],
		"types": []
	},
	"include": ["src/**/*.ts"]
}
